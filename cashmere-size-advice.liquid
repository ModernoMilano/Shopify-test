{%- liquid
  assign mm_is_cashmere = false
  assign mm_title = product.title | downcase
  if mm_title contains 'cashmere'
    assign mm_is_cashmere = true
  endif
  for mm_collection in product.collections
    if mm_collection.handle == 'cashmere'
      assign mm_is_cashmere = true
    endif
  endfor
-%}
{%- if mm_is_cashmere -%}
<div class="mm-fit-note" role="note" aria-label="Sizing advice">
  <span class="mm-fit-note__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3.5 16 16 3.5 20.5 8 8 20.5z"/>
      <path d="M7 12.5l1.6 1.6M9.5 10l1.6 1.6M12 7.5l1.6 1.6M14.5 5l1.6 1.6"/>
    </svg>
  </span>
  <div class="mm-fit-note__body">
    <p class="mm-fit-note__title">Sizing advice</p>
    <p class="mm-fit-note__text">Our cashmere is knitted for a close, refined fit. For the perfect fit, choose <strong>one size up</strong> from your usual size.</p>
  </div>
</div>

<style>
.mm-fit-note {
  --mm-fit-bg: #E3E0D7;
  --mm-fit-ink: #111111;
  --mm-fit-soft: #5A5650;
  --mm-fit-hair: rgba(17, 17, 17, .14);
  display: flex;
  align-items: center;
  gap: 14px;
  margin: 4px 0 14px;
  padding: 14px 16px;
  background: var(--mm-fit-bg);
  border: 1px solid var(--mm-fit-hair);
  border-left: 2px solid var(--mm-fit-ink);
  font-family: Arial, "Helvetica Neue", Helvetica, sans-serif;
  color: var(--mm-fit-ink);
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}
.mm-fit-note__icon {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border: 1px solid var(--mm-fit-ink);
  border-radius: 50%;
}
.mm-fit-note__icon svg {
  display: block;
  width: 18px;
  height: 18px;
}
.mm-fit-note__title {
  margin: 0 0 4px;
  font-size: 11px;
  line-height: 1.4;
  font-weight: 700;
  letter-spacing: 2.5px;
  text-transform: uppercase;
}
.mm-fit-note__text {
  margin: 0;
  font-size: 13px;
  line-height: 1.6;
  color: var(--mm-fit-soft);
}
.mm-fit-note__text strong {
  color: var(--mm-fit-ink);
  font-weight: 700;
}
@media screen and (max-width: 749px) {
  .mm-fit-note {
    gap: 12px;
    padding: 12px 14px;
  }
  .mm-fit-note__icon {
    width: 32px;
    height: 32px;
  }
  .mm-fit-note__icon svg {
    width: 16px;
    height: 16px;
  }
  .mm-fit-note__title {
    font-size: 10px;
    letter-spacing: 2px;
  }
  .mm-fit-note__text {
    font-size: 12.5px;
  }
}
</style>
{%- endif -%}
