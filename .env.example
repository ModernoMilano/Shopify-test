# Postgres (bv. Neon: neon.tech, gratis)
DATABASE_URL="postgresql://user:password@host:5432/modernomilano"

# Shopify: app in het Dev Dashboard (dev.shopify.com), geïnstalleerd op je winkel
# Scopes: read_products, read_orders, read_all_orders, read_reports,
#         read_shopify_payments_payouts, read_shopify_payments_accounts, read_shopify_payments_disputes
SHOPIFY_STORE_DOMAIN="xb1kd0-zv.myshopify.com"
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
# Alleen voor een oude custom app uit de Shopify-admin (in plaats van client ID + secret):
# SHOPIFY_ADMIN_TOKEN="shpat_..."

# Meta ads via Windsor.ai (onboard.windsor.ai, API key)
WINDSOR_API_KEY=""

# PayPal Live-app (developer.paypal.com, Apps & Credentials, Live) met Transaction Search aan
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET=""

# Teamleden die mogen inloggen: naam:wachtwoord, komma-gescheiden
TEAM_USERS="gijs:verander-mij"

# Geheim voor de automatische sync (zelfde waarde als GitHub-secret CRON_SECRET)
CRON_SECRET="lang-willekeurig-geheim"

# Optioneel: vanaf welke datum orders bij de eerste sync worden opgehaald (YYYY-MM-DD)
SYNC_ORDERS_FROM="2026-04-01"
