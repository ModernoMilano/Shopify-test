// Alle geldbedragen worden opgeslagen in centen (Int) om afrondingsfouten te voorkomen.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Supplier {
  id             String    @id @default(cuid())
  name           String    @unique
  kind           String    @default("dropship") // dropship | pod | wholesale
  contactName    String?
  email          String?
  website        String?
  country        String?
  processingDays Int?
  shippingDays   Int?
  notes          String?
  active         Boolean   @default(true)
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Product {
  id          String     @id // Shopify numeric id
  title       String
  handle      String?
  status      String?
  vendor      String?
  productType String?
  imageUrl    String?
  supplierId  String?
  supplier    Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  variants    Variant[]
  costRules   CostRule[]
  lineItems   LineItem[]
  shopifyUpdatedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Variant {
  id         String     @id // Shopify numeric id
  productId  String
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  title      String
  sku        String?
  priceCents Int
  costRules  CostRule[]
  lineItems  LineItem[]

  @@index([productId])
}

/// Inkoopprijs + verzendkosten van de leverancier, per stuk.
/// variantId leeg = geldt voor alle varianten van het product.
/// validFrom maakt historie mogelijk: oude orders houden de prijs van dat moment.
model CostRule {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?
  variant           Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  unitCostCents     Int
  shippingCostCents Int      @default(0)
  validFrom         DateTime
  note              String?
  createdAt         DateTime @default(now())

  @@index([productId, validFrom])
}

model Order {
  id               String     @id // Shopify numeric id
  name             String // bv. #1042
  createdAt        DateTime
  currency         String
  totalCents       Int // huidige totaalprijs incl. btw en verzending, na refunds
  taxCents         Int
  shippingCents    Int // verzendkosten betaald door klant
  discountCents    Int
  refundedCents    Int
  feesCents        Int? // echte transactiekosten (Shopify Payments) in EUR, incl. wisselkoers-fee
  fxFeesCents      Int? // waarvan wisselkoers-fee (klant betaalde in andere valuta)
  presentmentCurrency String?
  financialStatus  String?
  cancelledAt      DateTime?
  countryCode      String?
  test             Boolean    @default(false)
  lineItems        LineItem[]
  shopifyUpdatedAt DateTime
  syncedAt         DateTime   @default(now())

  @@index([createdAt])
}

model LineItem {
  id              String   @id // Shopify numeric id
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId       String?
  variant         Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  title           String
  variantTitle    String?
  quantity        Int
  currentQuantity Int // na refunds/verwijderingen
  unitPriceCents  Int

  @@index([orderId])
  @@index([productId])
}

model AdSpend {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  channel     String // meta | google | tiktok | pinterest | overig
  amountCents Int
  note        String?

  @@unique([date, channel])
}

/// Vaste maandelijkse kosten (apps, Shopify-abonnement, software, personeel, ...)
model Expense {
  id          String    @id @default(cuid())
  name        String
  category    String    @default("software")
  amountCents Int // per maand
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  createdAt   DateTime  @default(now())
}

model Setting {
  key   String @id
  value String
}

model SyncLog {
  id         String    @id @default(cuid())
  kind       String
  status     String // running | ok | error
  message    String?
  count      Int       @default(0)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

// ===========================================================================
// Financieel dashboard

/// Dagomzet uit Shopify (ShopifyQL), incl. btw. Per dag één rij.
model DailySales {
  date          DateTime @id @db.Date
  orders        Int
  grossCents    Int
  discountCents Int // negatief
  returnsCents  Int // negatief
  netCents      Int
  shippingCents Int
  taxesCents    Int
  totalCents    Int // total_sales = omzet
  source        String   @default("shopify") // shopify | handmatig | seed
  syncedAt      DateTime @default(now())
}

model BankTransaction {
  id             String    @id @default(cuid())
  account        String    @default("revolut")
  bookedAt       DateTime  @db.Date
  /// "hoort bij periode": standaard gelijk aan bookedAt, aan te passen (bv. Meta van vorige maand)
  periodDate     DateTime? @db.Date
  description    String
  details        String    @default("")
  amountCents    Int // + ontvangen, - uitgegeven
  feeCents       Int       @default(0)
  balanceCents   Int?
  category       String    @default("unknown")
  categorySource String    @default("regel") // regel | handmatig
  ruleId         String?
  note           String?
  importId       String?
  /// voorkomt dubbele imports
  fingerprint    String    @unique
  seq            Int       @default(0) // volgorde binnen het afschrift
  createdAt      DateTime  @default(now())

  @@index([bookedAt])
  @@index([category])
}

model CategoryRule {
  id        String   @id @default(cuid())
  pattern   String
  direction String   @default("any") // in | out | any
  category  String
  priority  Int      @default(50)
  createdAt DateTime @default(now())
}

model BankImport {
  id                  String   @id @default(cuid())
  fileName            String
  format              String // pdf | csv
  openingBalanceCents Int?
  closingBalanceCents Int?
  /// periode van het afschrift (uit de PDF-kop, of eerste en laatste mutatie bij CSV)
  periodFrom          DateTime? @db.Date
  periodTo            DateTime? @db.Date
  transactions        Int
  duplicates          Int
  reconciled          Boolean
  message             String?
  createdAt           DateTime @default(now())
}

model ShopifyPayout {
  id                 String   @id @default(cuid())
  externalId         String?  @unique
  payoutDate         DateTime @db.Date
  status             String   @default("paid")
  chargesCents       Int?
  refundsCents       Int?
  adjustmentsCents   Int?
  reservedFundsCents Int?
  feesCents          Int? // positief
  retriedCents       Int?
  totalCents         Int
  currency           String   @default("EUR")
  /// samenvatting van meerdere payouts (seed), vervangen bij een echte import
  summaryUntil       DateTime? @db.Date
  source             String   @default("csv")
  createdAt          DateTime @default(now())

  @@index([payoutDate])
}

model Dispute {
  id          String    @id
  orderName   String?
  openedAt    DateTime
  amountCents Int
  reason      String?
  status      String
  dueBy       DateTime?
  country     String?
  source      String    @default("shopify")
  updatedAt   DateTime  @updatedAt
}

/// Momentopname van waar het geld staat. Bank komt uit de laatste bankmutatie als die er is.
model MoneySnapshot {
  id                   String    @id @default(cuid())
  takenAt              DateTime  @default(now())
  bankCents            Int?
  payoutScheduledCents Int
  payoutScheduledDate  DateTime? @db.Date
  pendingCents         Int
  holdCents            Int
  paypalCents          Int
  source               String    @default("handmatig")
  /// herkomst per onderdeel: "Shopify" | "PayPal" | "handmatig"
  shopifySource        String    @default("handmatig")
  holdSource           String    @default("handmatig")
  paypalSource         String    @default("handmatig")
  note                 String?
}

/// Handmatige posten over een periode: PayPal-fees, teamkosten, voorraadwaarde, eenmalige kosten.
model ManualEntry {
  id          String   @id @default(cuid())
  kind        String // paypal_fees | fees | chargebacks | other | team | inventory | cogs | meta
  label       String
  amountCents Int
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  note        String?
  createdAt   DateTime @default(now())
}

model Loan {
  id             String    @id @default(cuid())
  lender         String
  principalCents Int
  startDate      DateTime  @db.Date
  repaidCents    Int       @default(0)
  schedule       String? // aflossingsafspraak in woorden
  active         Boolean   @default(true)
}

/// Openstaande of betaalde leveranciersfactuur, te koppelen aan een verkoopperiode.
model SupplierInvoice {
  id           String    @id @default(cuid())
  supplierName String
  amountCents  Int
  invoiceDate  DateTime  @db.Date
  dueDate      DateTime? @db.Date
  salesFrom    DateTime? @db.Date
  salesTo      DateTime? @db.Date
  paid         Boolean   @default(false)
  note         String?
  createdAt    DateTime  @default(now())
}

model MetaDaily {
  id                 String   @id @default(cuid())
  date               DateTime @db.Date
  campaign           String
  market             String?
  spendCents         Int
  clicks             Int      @default(0)
  impressions        Int      @default(0)
  purchases          Int      @default(0)
  purchaseValueCents Int      @default(0)
  frequency          Float?
  source             String   @default("windsor")

  @@unique([date, campaign])
}

model BudgetChange {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  campaign    String
  oldCents    Int
  newCents    Int
  note        String?
  createdAt   DateTime @default(now())
}

/// PayPal per dag (EUR), uit de Transaction Search API
model PaypalDaily {
  date             DateTime @id @db.Date
  salesCents       Int
  salesCount       Int
  feesCents        Int
  refundsCents     Int
  withdrawalsCents Int
  syncedAt         DateTime @default(now())
}

model SourceSync {
  source   String   @id // shopify_sales | shopify_payments | windsor | paypal | revolut
  lastAt   DateTime
  status   String // ok | fout
  message  String?
}
