// Alle geldbedragen worden opgeslagen in centen (Int) om afrondingsfouten te voorkomen.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Supplier {
  id             String    @id @default(cuid())
  name           String    @unique
  kind           String    @default("dropship") // dropship | pod | wholesale
  contactName    String?
  email          String?
  website        String?
  country        String?
  processingDays Int?
  shippingDays   Int?
  notes          String?
  active         Boolean   @default(true)
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Product {
  id          String     @id // Shopify numeric id
  title       String
  handle      String?
  status      String?
  vendor      String?
  productType String?
  imageUrl    String?
  supplierId  String?
  supplier    Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  variants    Variant[]
  costRules   CostRule[]
  lineItems   LineItem[]
  shopifyUpdatedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Variant {
  id         String     @id // Shopify numeric id
  productId  String
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  title      String
  sku        String?
  priceCents Int
  costRules  CostRule[]
  lineItems  LineItem[]

  @@index([productId])
}

/// Inkoopprijs + verzendkosten van de leverancier, per stuk.
/// variantId leeg = geldt voor alle varianten van het product.
/// validFrom maakt historie mogelijk: oude orders houden de prijs van dat moment.
model CostRule {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?
  variant           Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  unitCostCents     Int
  shippingCostCents Int      @default(0)
  validFrom         DateTime
  note              String?
  createdAt         DateTime @default(now())

  @@index([productId, validFrom])
}

model Order {
  id               String     @id // Shopify numeric id
  name             String // bv. #1042
  createdAt        DateTime
  currency         String
  totalCents       Int // huidige totaalprijs incl. btw en verzending, na refunds
  taxCents         Int
  shippingCents    Int // verzendkosten betaald door klant
  discountCents    Int
  refundedCents    Int
  feesCents        Int? // echte transactiekosten (Shopify Payments) in EUR, incl. wisselkoers-fee
  fxFeesCents      Int? // waarvan wisselkoers-fee (klant betaalde in andere valuta)
  presentmentCurrency String?
  financialStatus  String?
  cancelledAt      DateTime?
  countryCode      String?
  test             Boolean    @default(false)
  lineItems        LineItem[]
  shopifyUpdatedAt DateTime
  syncedAt         DateTime   @default(now())

  @@index([createdAt])
}

model LineItem {
  id              String   @id // Shopify numeric id
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId       String?
  variant         Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  title           String
  variantTitle    String?
  quantity        Int
  currentQuantity Int // na refunds/verwijderingen
  unitPriceCents  Int

  @@index([orderId])
  @@index([productId])
}

model AdSpend {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  channel     String // meta | google | tiktok | pinterest | overig
  amountCents Int
  note        String?

  @@unique([date, channel])
}

/// Vaste maandelijkse kosten (apps, Shopify-abonnement, software, personeel, ...)
model Expense {
  id          String    @id @default(cuid())
  name        String
  category    String    @default("software")
  amountCents Int // per maand
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  createdAt   DateTime  @default(now())
}

model Setting {
  key   String @id
  value String
}

model SyncLog {
  id         String    @id @default(cuid())
  kind       String
  status     String // running | ok | error
  message    String?
  count      Int       @default(0)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}
