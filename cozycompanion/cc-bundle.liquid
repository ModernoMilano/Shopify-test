{%- comment -%}
  CozyCompanion "Complete the set" bundle (theme block, sits under the buy buttons).
  Partners come from the product metafield custom.bundle_products; the 20% is an automatic discount per set
  (bundles.py), so the price shown here is exactly what the cart applies.
{%- endcomment -%}
{%- liquid
  assign p = closest.product
  assign partners = p.metafields.custom.bundle_products.value
  assign set_name = p.metafields.custom.bundle_name.value | default: 'Complete the set'
  assign pct = 20
-%}
{%- if p != blank and partners != blank and partners.size > 0 -%}
  {%- liquid
    assign main_variant = p.selected_or_first_available_variant
    assign total = main_variant.price
    assign all_available = main_variant.available
    for q in partners
      if q == blank
        continue
      endif
      assign total = total | plus: q.selected_or_first_available_variant.price
      unless q.available
        assign all_available = false
      endunless
    endfor
    assign saved = total | times: pct | divided_by: 100
    assign bundle_price = total | minus: saved
  -%}
  <div class="cc-bundle" data-cc-bundle data-pct="{{ pct }}" {{ block.shopify_attributes }}>
    <div class="cc-bundle__head">
      <p class="cc-bundle__eyebrow">Complete the set &middot; save {{ pct }}%</p>
      <p class="cc-bundle__name">{{ set_name }}</p>
    </div>
    <ul class="cc-bundle__items" role="list">
      <li class="cc-bundle__item">
        {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: p.title, class: 'cc-bundle__img' }}{%- endif -%}
        <span class="cc-bundle__text">
          <span class="cc-bundle__title">This item: {{ p.title }}</span>
          <span class="cc-bundle__price" data-cc-main-price="{{ main_variant.price }}">{{ main_variant.price | money }}</span>
        </span>
      </li>
      {%- for q in partners -%}
        {%- if q == blank -%}{%- continue -%}{%- endif -%}
        <li class="cc-bundle__item">
          <span class="cc-bundle__plus" aria-hidden="true">+</span>
          <a href="{{ q.url }}">{%- if q.featured_image -%}{{ q.featured_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: q.title, class: 'cc-bundle__img' }}{%- endif -%}</a>
          <span class="cc-bundle__text">
            <a class="cc-bundle__title" href="{{ q.url }}">{{ q.title }}</a>
            {%- if q.has_only_default_variant -%}
              <input type="hidden" data-cc-part value="{{ q.selected_or_first_available_variant.id }}" data-price="{{ q.selected_or_first_available_variant.price }}">
              <span class="cc-bundle__price">{{ q.price | money }}</span>
            {%- else -%}
              <select class="cc-bundle__select" data-cc-part aria-label="{{ q.title }} option">
                {%- for v in q.variants -%}
                  {%- if v.available -%}
                    <option value="{{ v.id }}" data-price="{{ v.price }}"{% if v.id == q.selected_or_first_available_variant.id %} selected{% endif %}>{{ v.title }} &middot; {{ v.price | money }}</option>
                  {%- endif -%}
                {%- endfor -%}
              </select>
            {%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
    <div class="cc-bundle__total">
      <span>Set price</span>
      <s data-cc-was>{{ total | money }}</s>
      <strong data-cc-now>{{ bundle_price | money }}</strong>
    </div>
    <button type="button" class="cc-bundle__add" data-cc-bundle-add {% unless all_available %}disabled{% endunless %}>
      {%- if all_available -%}Add the set &middot; save <span data-cc-saved>{{ saved | money }}</span>{%- else -%}Set currently unavailable{%- endif -%}
    </button>
    <p class="cc-bundle__note">{{ pct }}% off the set is applied automatically in your cart.</p>
  </div>

  <style>
    .cc-bundle { display: grid; gap: 12px; padding: 18px; background: #ebe3da; color: #1a1a1a; }
    .cc-bundle__eyebrow { margin: 0; font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: #b76e79; }
    .cc-bundle__name { margin: 2px 0 0; font-family: var(--font-heading--family); font-size: 1.35rem; line-height: 1.2; }
    .cc-bundle__items { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
    .cc-bundle__item { position: relative; display: grid; grid-template-columns: 64px 1fr; gap: 12px; align-items: center; }
    .cc-bundle__plus { position: absolute; left: -2px; top: -12px; width: 18px; height: 18px; border-radius: 50%; background: #b76e79;
      color: #fff; font-size: 13px; line-height: 18px; text-align: center; }
    .cc-bundle__img { width: 64px; height: 64px; object-fit: cover; display: block; background: #f5f1ed; }
    .cc-bundle__text { display: grid; gap: 4px; font-size: 0.85rem; line-height: 1.3; min-width: 0; }
    .cc-bundle__title { color: inherit; text-decoration: none; }
    .cc-bundle__price { opacity: 0.75; }
    .cc-bundle__select { font: inherit; font-size: 0.8rem; padding: 6px 8px; border: 1px solid #1a1a1a33; background: #fff; color: inherit; max-width: 100%; }
    .cc-bundle__total { display: flex; align-items: baseline; gap: 10px; padding-top: 10px; border-top: 1px solid #1a1a1a1f; font-size: 0.9rem; }
    .cc-bundle__total span { flex: 1; }
    .cc-bundle__total s { opacity: 0.55; }
    .cc-bundle__total strong { font-size: 1.15rem; color: #b76e79; }
    .cc-bundle__add { padding: 14px 16px; border: 0; background: #1a1a1a; color: #f5f1ed; font: inherit; font-size: 0.8rem;
      letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer; }
    .cc-bundle__add:hover { background: #b76e79; }
    .cc-bundle__add[disabled] { opacity: 0.5; cursor: default; }
    .cc-bundle__note { margin: 0; font-size: 0.75rem; opacity: 0.65; }
  </style>

  <script type="module">
    import { CartLinesUpdateEvent } from '@shopify/events';
    const money = (cents) => {
      try { return new Intl.NumberFormat(document.documentElement.lang || 'en-US', { style: 'currency', currency: {{ cart.currency.iso_code | json }} }).format(cents / 100); }
      catch (e) { return '$' + (cents / 100).toFixed(2); }
    };
    for (const box of document.querySelectorAll('[data-cc-bundle]:not([data-ready])')) {
      box.dataset.ready = '1';
      const pct = Number(box.dataset.pct);
      const parts = () => [...box.querySelectorAll('[data-cc-part]')];
      const priceOf = (el) => Number(el.tagName === 'SELECT' ? el.selectedOptions[0]?.dataset.price : el.dataset.price) || 0;
      const mainVariantId = () => {
        const input = box.closest('.shopify-section, product-information, main')?.querySelector('form[action*="/cart/add"] [name="id"]');
        return input?.value;
      };
      const update = () => {
        const total = Number(box.querySelector('[data-cc-main-price]').dataset.ccMainPrice) + parts().reduce((s, el) => s + priceOf(el), 0);
        const saved = Math.round(total * pct / 100);
        box.querySelector('[data-cc-was]').textContent = money(total);
        box.querySelector('[data-cc-now]').textContent = money(total - saved);
        const sv = box.querySelector('[data-cc-saved]'); if (sv) sv.textContent = money(saved);
      };
      box.addEventListener('change', update);
      box.querySelector('[data-cc-bundle-add]')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget; const label = btn.innerHTML;
        const ids = [mainVariantId(), ...parts().map((el) => el.value)].filter(Boolean);
        btn.disabled = true; btn.textContent = 'Adding the set…';
        const sectionIds = [...document.querySelectorAll('cart-items-component[data-section-id]')].map((el) => el.dataset.sectionId);
        const deferred = CartLinesUpdateEvent.createPromise();
        document.dispatchEvent(new CartLinesUpdateEvent({
          action: 'add', context: 'product',
          lines: ids.map((id) => ({ merchandiseId: id, quantity: 1 })),
          promise: deferred.promise,
        }));
        try {
          const res = await fetch(Theme.routes.cart_add_url, {
            method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ items: ids.map((id) => ({ id: Number(id), quantity: 1 })), sections: sectionIds.join(',') }),
          }).then((r) => r.json());
          const cart = await fetch(Theme.routes.cart_url + '.js', { headers: { Accept: 'application/json' } }).then((r) => r.json());
          deferred.resolve({ cart: CartLinesUpdateEvent.createCartFromAjaxResponse(cart),
            detail: { items: cart.items, source: 'cc-bundle', itemCount: ids.length, sections: res.sections, didError: Boolean(res.status) } });
          if (res.status) { btn.textContent = res.description || 'Could not add the set'; setTimeout(() => { btn.innerHTML = label; btn.disabled = false; }, 3000); return; }
          btn.textContent = 'Added ✓'; setTimeout(() => { btn.innerHTML = label; btn.disabled = false; update(); }, 2500);
        } catch (err) {
          deferred.reject(err); btn.innerHTML = label; btn.disabled = false;
        }
      });
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "CozyCompanion bundle",
  "tag": null,
  "settings": [],
  "presets": [{ "name": "CozyCompanion bundle" }]
}
{% endschema %}
