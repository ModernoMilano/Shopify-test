    "story": {
      "type": "media-with-content",
      "settings": {
        "media_position": "left",
        "media_width": "medium",
        "media_height": "60svh",
        "section_width": "full-width",
        "background_color": "#ebe3da"
      },
      "blocks": {
        "media": {
          "type": "_media-without-appearance",
          "static": true,
          "settings": {
            "media_type": "image",
            "image": "shopify://shop_images/cozycompanion-h3_story.png"
          },
          "blocks": {}
        },
        "content": {
          "type": "_content-without-appearance",
          "static": true,
          "settings": {
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "center",
            "gap": 20
          },
          "blocks": {
            "eyebrow": {
              "type": "text",
              "settings": {
                "text": "<p>Chapter I &middot; The bond</p>",
                "type_preset": "h6",
                "width": "fit-content",
                "alignment": "left",
                "max_width": "normal",
                "padding-block-end": 0,
                "text_color": "#b76e79"
              },
              "blocks": {}
            },
            "heading": {
              "type": "text",
              "settings": {
                "text": "<h2>Made for the moments that matter.</h2>",
                "type_preset": "h2",
                "width": "fit-content",
                "alignment": "left",
                "max_width": "narrow",
                "padding-block-end": 0
              },
              "blocks": {}
            },
            "body": {
              "type": "text",
              "settings": {
                "text": "<p>CozyCompanion began with a simple idea: our pets deserve the same care we put into our homes. Things that look beautiful, feel good and simply work.</p><p>So we curate a small, considered collection: plush beds, refined bowls, coats for every weather and play that keeps curious minds busy. Nothing loud, nothing disposable.</p>",
                "type_preset": "rte",
                "width": "fit-content",
                "alignment": "left",
                "max_width": "narrow",
                "padding-block-end": 0
              },
              "blocks": {}
            },
            "cta": {
              "type": "button",
              "settings": {
                "label": "Discover our story",
                "link": "shopify://pages/about",
                "style_class": "button-secondary"
              },
              "blocks": {}
            }
          },
          "block_order": [
            "eyebrow",
            "heading",
            "body",
            "cta"
          ]
        }
      }
    },
