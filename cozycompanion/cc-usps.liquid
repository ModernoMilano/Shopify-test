{%- comment -%}
  CozyCompanion USP row with line icons (snippets/cc-icon.liquid), shown at the bottom of collection pages.
{%- endcomment -%}
<section class="cc-usps" aria-label="Why shop with CozyCompanion">
  <ul class="cc-usps__list" role="list">
    {%- for block in section.blocks -%}
      <li class="cc-usps__item" {{ block.shopify_attributes }}>
        <span class="cc-usps__icon">{% render 'cc-icon', name: block.settings.icon %}</span>
        <span class="cc-usps__title">{{ block.settings.title | escape }}</span>
        {%- if block.settings.text != blank -%}<span class="cc-usps__text">{{ block.settings.text | escape }}</span>{%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</section>
<style>
  /* the theme lets its last section shrink to its content; this one must span the page */
  #shopify-section-{{ section.id }} { width: 100%; max-width: none; align-self: stretch; justify-self: stretch; flex: 1 1 auto; grid-column: 1 / -1; }
  .cc-usps { display: block; width: 100%; box-sizing: border-box; background: #f5f1ed; color: #1a1a1a;
    padding: 40px 16px; margin: 32px 0 0; border-top: 1px solid #ebe3da; }
  .cc-usps * { box-sizing: border-box; }
  .cc-usps .cc-usps__list { list-style: none; margin: 0 auto; padding: 0; width: min(100%, 1080px); max-width: 1080px; justify-content: center;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .cc-usps .cc-usps__item { list-style: none; margin: 0; padding: 0 8px; min-width: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: flex-start; text-align: center; gap: 8px; }
  .cc-usps .cc-usps__item + .cc-usps__item { border-left: 1px solid #e3dbd2; }
  .cc-usps .cc-usps__icon { flex: 0 0 auto; width: 52px; height: 52px; border-radius: 50%; background: #ebe3da; color: #b76e79;
    display: flex; align-items: center; justify-content: center; }
  .cc-usps .cc-usps__icon svg { display: block; width: 24px; height: 24px; max-width: none; }
  .cc-usps .cc-usps__title { display: block; margin: 4px 0 0; font-family: var(--font-heading--family); font-size: 1.15rem; line-height: 1.2; }
  .cc-usps .cc-usps__text { display: block; margin: 0; font-size: 0.82rem; line-height: 1.45; opacity: 0.7; max-width: 220px; }
  @media screen and (max-width: 749px) {
    .cc-usps { padding: 28px 12px; }
    .cc-usps .cc-usps__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 8px; }
    .cc-usps .cc-usps__item + .cc-usps__item { border-left: 0; }
    .cc-usps .cc-usps__icon { width: 44px; height: 44px; }
    .cc-usps .cc-usps__icon svg { width: 21px; height: 21px; }
    .cc-usps .cc-usps__title { font-size: 1rem; }
    .cc-usps .cc-usps__text { display: none; }
  }
</style>

{% schema %}
{
  "name": "CC USPs",
  "settings": [],
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (cc-icon name)", "default": "paw" },
        { "type": "text", "id": "title", "label": "Title", "default": "Title" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "CC USPs" }]
}
{% endschema %}
