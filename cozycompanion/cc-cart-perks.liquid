{% doc %}
  CozyCompanion cart extras: bundle progress, delivery cut-off, upsells and reassurance.
  Every message reflects a real offer or policy (no fake timers or stock counts).

  @param {string} part - 'top', 'bottom' or 'empty'
{% enddoc %}

{%- liquid
  assign bundle = collections['bundle-deals']
  assign today = 'now' | date: '%m%d' | plus: 0
  assign cart_ids = cart.items | map: 'product_id'
-%}

{%- if part == 'top' -%}
  <div class="cc-cart-top">
    {%- if cart.item_count == 1 -%}
      <p class="cc-cart-top__msg">Add <strong>1 more piece</strong> and save <strong>10%</strong> automatically</p>
      <div class="cc-progress" aria-hidden="true"><span style="width: 50%"></span></div>
    {%- elsif cart.total_discount > 0 -%}
      <p class="cc-cart-top__msg">&#10003; Bundle &amp; Save unlocked: you're saving <strong>{{ cart.total_discount | money }}</strong></p>
      <div class="cc-progress" aria-hidden="true"><span style="width: 100%"></span></div>
    {%- else -%}
      <p class="cc-cart-top__msg">&#10003; Tracked shipping around the world on every order</p>
    {%- endif -%}

    {%- if today >= 1101 and today <= 1208 -%}
      <p class="cc-cart-top__note">Holiday gifting: order by <strong>8 December</strong> for the best chance of EU delivery before Christmas.</p>
    {%- else -%}
      <p class="cc-cart-top__note">Prepared with care and dispatched within 1&ndash;3 business days.</p>
    {%- endif -%}
  </div>

{%- elsif part == 'bottom' -%}
  {%- liquid
    assign shown = 0
  -%}
  {%- capture upsells -%}
    {%- for product in bundle.products -%}
      {%- if shown >= 2 -%}{%- break -%}{%- endif -%}
      {%- unless cart_ids contains product.id or product.available == false -%}
        {%- assign shown = shown | plus: 1 -%}
        <a class="cc-upsell" href="{{ product.url }}">
          {%- if product.featured_image -%}
            {{ product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: product.title, class: 'cc-upsell__img' }}
          {%- endif -%}
          <span class="cc-upsell__text">
            <span class="cc-upsell__title">{{ product.title }}</span>
            <span class="cc-upsell__price">{{ product.price | money }}</span>
          </span>
          <span class="cc-upsell__cta">View</span>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}

  <div class="cc-cart-bottom">
    {%- if shown > 0 -%}
      <div class="cc-upsells">
        <p class="cc-label">Complete the ritual{% if cart.item_count == 1 %} &middot; 10% off with 2 pieces{% endif %}</p>
        {{ upsells }}
      </div>
    {%- endif -%}

    <ul class="cc-usps">
      <li>{% render 'icon-or-image', icon: 'truck', width: 16, class_name: 'cc-usp-icon' %}<span>Tracked shipping around the world</span></li>
      <li>{% render 'icon-or-image', icon: 'return', width: 16, class_name: 'cc-usp-icon' %}<span>30-day happiness guarantee</span></li>
      <li>{% render 'icon-or-image', icon: 'lock', width: 16, class_name: 'cc-usp-icon' %}<span>Secure, encrypted checkout</span></li>
    </ul>

    {%- if shop.enabled_payment_types.size > 0 -%}
      <div class="cc-payments">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'cc-payments__icon' }}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

{%- elsif part == 'empty' -%}
  <div class="cc-cart-empty">
    <p>Your cosy evening starts here.</p>
    <div class="cc-cart-empty__links">
      <a class="button" href="{{ routes.collections_url }}/cozy-heated-blankets">Heated blankets</a>
      <a class="button button-secondary" href="{{ routes.collections_url }}/smart-pet-tech">Smart pet tech</a>
    </div>
  </div>
{%- endif -%}

<style>
  .cc-cart-top { padding: 12px var(--cart-drawer-padding, 16px) 16px; display: grid; gap: 8px; text-align: center; }
  .cc-cart-top__msg { margin: 0; font-size: 0.875rem; line-height: 1.4; }
  .cc-cart-top__note { margin: 0; font-size: 0.75rem; line-height: 1.4; opacity: 0.75; }
  .cc-progress { height: 4px; background: #e3dbd2; border-radius: 4px; overflow: hidden; }
  .cc-progress span { display: block; height: 100%; background: #b76e79; border-radius: 4px; transition: width 0.4s ease; }
  .cc-cart-bottom { width: 100%; display: grid; gap: 14px; }
  .cc-label { margin: 0 0 6px; font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: #b76e79; }
  .cc-upsells { display: grid; gap: 8px; }
  .cc-upsell { display: grid; grid-template-columns: 52px 1fr auto; align-items: center; gap: 12px; padding: 8px; background: #ebe3da; color: inherit; text-decoration: none; }
  .cc-upsell__img { width: 52px; height: 52px; object-fit: cover; display: block; }
  .cc-upsell__text { display: grid; gap: 2px; font-size: 0.8rem; line-height: 1.3; }
  .cc-upsell__price { opacity: 0.75; }
  .cc-upsell__cta { font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; border-bottom: 1px solid currentColor; }
  .cc-usps { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .cc-usps li { display: flex; align-items: center; gap: 10px; font-size: 0.78rem; line-height: 1.3; }
  .cc-usps svg { width: 16px; height: 16px; flex: none; color: #b76e79; }
  .cc-payments { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; }
  .cc-payments__icon { height: 20px; width: auto; }
  .cc-cart-empty { display: grid; gap: 16px; justify-items: center; padding: 16px; }
  .cc-cart-empty p { margin: 0; }
  .cc-cart-empty__links { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
</style>
